{
  "name": "sherpahr-project-desk",
  "version": "7.0.0",
  "private": true,
  "scripts": {
    "start": "ng serve --host 127.0.0.1 --proxy-config proxy.conf.json",
    "build": "ng build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "node --test tests/*.test.ts",
    "e2e": "playwright test",
    "check": "npm run contract:check && npm run lint && npm run typecheck && npm test && npm run build",
    "contract:generate": "openapi-ts",
    "contract:check": "sh tools/check-contract.sh"
  },
  "dependencies": {
    "@angular/common": "22.2.3",
    "@angular/compiler": "22.2.3",
    "@angular/core": "22.2.3",
    "@angular/forms": "22.2.3",
    "@angular/platform-browser": "22.2.3",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@angular/build": "22.3.0",
    "@angular/cli": "22.2.4",
    "@angular/compiler-cli": "22.2.3",
    "@eslint/js": "^10.0.1",
    "@hey-api/openapi-ts": "0.97.0",
    "@playwright/test": "1.65.1",
    "angular-eslint": "^22.8.0",
    "eslint": "^10.15.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.74.0"
  }
}
