{
    "name": "sherparpa/project-desk-backend",
    "description": "Project Desk JSON API",
    "type": "project",
    "require": {
        "php": "~8.4.0",
        "ext-pdo": "*",
        "ext-pdo_sqlite": "*"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "ProjectDesk\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ProjectDesk\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.4.0"
        },
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse"
    }
}
